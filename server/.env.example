PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-string
CLIENT_URL=http://localhost:5173

# Database (Supabase PostgreSQL Connection Pooler)
# Session pooler (5432) or Transaction pooler (6543)
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Storage (Parcel Photos)
# Project URL: https://[PROJECT-REF].supabase.co
SUPABASE_URL=https://[PROJECT-REF].supabase.co
# Service role key (Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
# Bucket name (default is parcel-photos)
SUPABASE_STORAGE_BUCKET=parcel-photos
